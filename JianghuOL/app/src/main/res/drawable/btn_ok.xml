<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="#8FCAA8" />
            <stroke
                android:width="1.5dp"
                android:color="#D8F5E4" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <gradient
                android:angle="270"
                android:endColor="#2F6B4E"
                android:startColor="#4FA078"
                android:type="linear" />
            <stroke
                android:width="1dp"
                android:color="#9FD9B8" />
        </shape>
    </item>
</selector>
