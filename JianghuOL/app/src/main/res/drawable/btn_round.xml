<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="#3A5C50" />
            <stroke
                android:width="1.5dp"
                android:color="#9AD4B4" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <gradient
                android:angle="270"
                android:endColor="#1A2220"
                android:startColor="#2A3832"
                android:type="linear" />
            <stroke
                android:width="1dp"
                android:color="#5A7068" />
        </shape>
    </item>
</selector>
