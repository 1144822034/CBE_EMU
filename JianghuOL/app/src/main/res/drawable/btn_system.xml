<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#3A4A45" />
            <stroke
                android:width="1.5dp"
                android:color="#8AA89C" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient
                android:angle="270"
                android:endColor="#141C1A"
                android:startColor="#222E2A" />
            <stroke
                android:width="1dp"
                android:color="#4A5E56" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>
