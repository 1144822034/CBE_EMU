<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="JianghuButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">#E8F2EB</item>
        <item name="android:textSize">@dimen/ctrl_key_text</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:gravity">center</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:paddingLeft">0dp</item>
        <item name="android:paddingRight">0dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">0dp</item>
    </style>

    <!-- 统一方形控制键：宽高均为 ctrl_key_size -->
    <style name="JianghuButton.Key" parent="JianghuButton">
        <item name="android:layout_width">@dimen/ctrl_key_size</item>
        <item name="android:layout_height">@dimen/ctrl_key_size</item>
        <item name="android:background">@drawable/btn_action</item>
    </style>

    <style name="JianghuButton.Round" parent="JianghuButton.Key">
        <item name="android:background">@drawable/btn_round</item>
        <item name="android:textSize">@dimen/ctrl_dpad_text</item>
    </style>

    <style name="JianghuButton.Ok" parent="JianghuButton.Key">
        <item name="android:background">@drawable/btn_ok</item>
        <item name="android:textColor">#06110D</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">@dimen/ctrl_ok_text</item>
    </style>

    <style name="JianghuButton.Action" parent="JianghuButton.Key">
        <item name="android:background">@drawable/btn_action</item>
        <item name="android:textSize">@dimen/ctrl_key_text</item>
    </style>

    <style name="JianghuButton.Danger" parent="JianghuButton.Key">
        <item name="android:background">@drawable/btn_danger</item>
        <item name="android:textSize">@dimen/ctrl_key_text</item>
    </style>

    <style name="JianghuButton.System" parent="JianghuButton.Key">
        <item name="android:background">@drawable/btn_system</item>
        <item name="android:textColor">#C9D7D0</item>
        <item name="android:textSize">@dimen/ctrl_key_text</item>
    </style>
</resources>
